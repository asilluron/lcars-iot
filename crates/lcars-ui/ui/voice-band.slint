import { Theme } from "theme.slint";

export component VoiceBand inherits Rectangle {
    in property <string> phase: "LISTENING";
    in property <string> text: "";
    callback cancel();

    height: 72px;
    border-radius: 16px;
    background: Theme.mute;

    HorizontalLayout {
        padding: 8px;
        spacing: 8px;

        Rectangle {
            width: 168px;
            border-radius: 12px;
            background: root.phase == "STREAMING" ? Theme.orange : root.phase == "PROCESSING" ? Theme.purple : Theme.peach;
            Text {
                text: root.phase;
                color: Theme.ink;
                font-size: 18px;
                font-weight: 700;
                horizontal-alignment: right;
                vertical-alignment: center;
                width: parent.width - 16px;
                x: 0px;
                height: 100%;
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            Text {
                text: root.text;
                color: Theme.cream-text;
                font-size: 20px;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-alignment: left;
                x: 8px;
                width: parent.width - 16px;
                height: 100%;
                overflow: elide;
            }
        }

        Rectangle {
            width: 112px;
            border-radius: 12px;
            background: touch.pressed ? Theme.alert.brighter(0.2) : Theme.alert;
            Text {
                text: "CANCEL";
                color: Theme.ink;
                font-size: 16px;
                font-weight: 700;
                horizontal-alignment: right;
                vertical-alignment: center;
                width: parent.width - 12px;
                height: 100%;
            }
            touch := TouchArea {
                width: 100%;
                height: 100%;
                clicked => { root.cancel(); }
            }
        }
    }
}

export component MicChip inherits Rectangle {
    width: 148px;
    height: 36px;
    border-radius: 12px;
    background: Theme.alert;
    Text {
        text: "MIC OFFLINE";
        color: Theme.ink;
        font-size: 14px;
        font-weight: 700;
        horizontal-alignment: right;
        vertical-alignment: center;
        width: parent.width - 12px;
        height: 100%;
    }
}
