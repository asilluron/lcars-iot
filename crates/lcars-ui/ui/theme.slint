export global Theme {
    in-out property <bool> night: false;
    in-out property <color> bg: #000000;
    in-out property <color> accent-1: #FF9966;
    in-out property <color> accent-2: #CC99CC;
    in-out property <color> accent-3: #9999FF;
    in-out property <color> accent-4: #FFCC99;
    in-out property <color> alert: #CC4444;
    in-out property <color> text-on-accent: #000000;
    in-out property <color> blue: #9ba4ff;
    in-out property <color> orange: #ff9c34;
    in-out property <color> peach: #fec893;
    in-out property <color> purple: #c79adf;
    in-out property <color> cream: #ffe6be;
    in-out property <color> cream-text: #f3e6d4;
    in-out property <color> gold: #f5d454;
    in-out property <color> done: #75db9a;
    in-out property <color> ink: #141414;
    in-out property <color> mute: #2a2733;
    in-out property <color> dim-text: #b7a99a;
    in-out property <length> grid: 8px;
    in-out property <length> touch-min: 48px;
    in-out property <float> scale: 1.0;
    in-out property <length> sidebar-width: 220px;
    in-out property <length> header-height: 80px;

    // Ultraviolet night: violet bars, magenta lanes, cyan highlights on a near-black field.
    public function set-night(on: bool) {
        Theme.night = on;
        Theme.bg = on ? #05010c : #000000;
        Theme.accent-1 = on ? #c084fc : #FF9966;
        Theme.accent-2 = on ? #e879f9 : #CC99CC;
        Theme.accent-3 = on ? #67e8f9 : #9999FF;
        Theme.accent-4 = on ? #d4b3ff : #FFCC99;
        Theme.alert = on ? #ff4d6a : #CC4444;
        Theme.text-on-accent = on ? #14081c : #000000;
        Theme.blue = on ? #67e8f9 : #9ba4ff;
        Theme.orange = on ? #c084fc : #ff9c34;
        Theme.peach = on ? #f0abfc : #fec893;
        Theme.purple = on ? #e879f9 : #c79adf;
        Theme.cream = on ? #ddd6fe : #ffe6be;
        Theme.cream-text = on ? #e9e4ff : #f3e6d4;
        Theme.gold = on ? #67e8f9 : #f5d454;
        Theme.done = on ? #5eead4 : #75db9a;
        Theme.ink = on ? #14081c : #141414;
        Theme.mute = on ? #1a1028 : #2a2733;
        Theme.dim-text = on ? #9b8bb4 : #b7a99a;
    }
}
