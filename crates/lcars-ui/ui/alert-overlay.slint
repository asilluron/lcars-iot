import { Theme } from "theme.slint";

export component AlertOverlay inherits Rectangle {
    in property <string> title;
    in property <string> body;
    in property <bool> bright: true;
    callback dismiss-press(bool);

    background: root.bright ? Theme.alert : #881818;

    VerticalLayout {
        alignment: center;
        padding: Theme.grid * 4;
        spacing: Theme.grid * 2;
        Text {
            text: root.title;
            color: Theme.text-on-accent;
            font-size: 48px;
            font-weight: 700;
            horizontal-alignment: center;
        }
        Text {
            text: root.body;
            color: Theme.text-on-accent;
            font-size: 24px;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        Text {
            text: "HOLD TO DISMISS";
            color: Theme.text-on-accent;
            horizontal-alignment: center;
            font-size: 16px;
        }
    }

    TouchArea {
        width: 100%;
        height: 100%;
        changed pressed => {
            root.dismiss-press(self.pressed);
        }
    }
}
